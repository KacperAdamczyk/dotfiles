{{- $colimaDrive := dig "colima" "drive" "" . -}}
# Homebrew (Apple Silicon, Intel mac, Linux)
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew
    if test -x $brew_bin
        $brew_bin shellenv | source
        break
    end
end

# Editor
set -gx EDITOR hx
set -gx VISUAL hx

{{ if $colimaDrive -}}
# Containers — keep colima's VM, and with it every container image layer,
# volume and build cache, on {{ $colimaDrive }} rather than the boot disk.
# Falls back to the default ~/.colima when that drive is not mounted, so a
# detached drive degrades to a separate empty VM rather than a broken one.
if test -d {{ $colimaDrive | quote }}
    set -gx COLIMA_HOME {{ $colimaDrive }}/colima
end

{{ end -}}
# Runtime version manager
if command -q mise
    mise activate fish | source
end

status is-interactive; and begin
{{- if eq .chezmoi.os "darwin" }}
    # Put keys whose passphrase is stored in the login keychain back into the
    # agent. The agent is empty after a reboot, and git's ssh signing shells out
    # to ssh-keygen, which does not read ssh_config and so cannot reach
    # UseKeychain on its own — without this, the first commit after every reboot
    # prompts for the passphrase. Idempotent and silent: keys already loaded, or
    # with no passphrase in the keychain, are skipped.
    if command -q ssh-add
        ssh-add --apple-load-keychain -q 2>/dev/null
    end
{{ end }}
    if command -q zoxide
        zoxide init fish | source
    end

    if command -q atuin
        atuin init fish | source
    end

    if command -q direnv
        direnv hook fish | source
    end

    if test "$TERM" != dumb; and command -q starship
        starship init fish | source
    end
end
