#!/bin/sh
# Installs/updates packages whenever the Brewfile changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -eu

if ! command -v brew >/dev/null 2>&1; then
    echo "error: Homebrew is required; install it and add it to PATH, then rerun chezmoi apply (see README.md)" >&2
    exit 1
fi

brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile"
